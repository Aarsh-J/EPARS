# ePARS Environment Configuration
# Copy this file to .env and fill in your actual values.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epars_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Anthropic API — get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ChromaDB path — point this to wherever your chroma_db folder is
# Default assumes epars_policies/ is a sibling folder to epars_agent/
CHROMA_DB_PATH=C:\Users\aarna\OneDrive\Desktop\Capstone\epars_policies\chroma_db
