# PostgreSQL — single connection string (e.g. from Supabase: Project Settings > Database)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# get the GROQ api key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Single administrator account. Generate a password hash from the backend folder:
# python -c "import getpass; from modules.auth import hash_password; print(hash_password(getpass.getpass('Admin password: ')))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_generated_pbkdf2_hash

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Use false for plain-HTTP local development; production must use HTTPS.
AUTH_COOKIE_SECURE=false

# Use none (with HTTPS/Secure cookies) only when the frontend and API are cross-site.
AUTH_COOKIE_SAMESITE=lax
